{
  "name": "dsh-kb",
  "version": "0.0.1",
  "private": true,
  "description": "Obsidian-native knowledge base for DeepSeek Harness: a compiler, not a retriever.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22" },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": ["dist", "scripts", "skills", "cordis.patch.yml", "README.md", "LICENSE", "docs"],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test --test-isolation=none .test-build/tests/*.test.js",
    "bench": "node bench/run.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0"
  }
}
