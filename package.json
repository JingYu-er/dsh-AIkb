{
  "name": "dsh-aikb",
  "version": "0.1.2",
  "description": "dsh-AIkb — Obsidian-native knowledge base for DeepSeek Harness: a compiler, not a retriever.",
  "repository": { "type": "git", "url": "git+https://github.com/JingYu-er/dsh-AIkb.git" },
  "homepage": "https://github.com/JingYu-er/dsh-AIkb#readme",
  "bugs": { "url": "https://github.com/JingYu-er/dsh-AIkb/issues" },
  "license": "Apache-2.0",
  "author": "JingYu",
  "keywords": ["deepseek-harness", "dsh-plugin", "obsidian", "knowledge-base", "bm25", "local-first", "pdf", "epub"],
  "type": "module",
  "engines": { "node": ">=22" },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./client/kb-panel.js",
    "./package.json": "./package.json"
  },
  "files": ["dist", "client", "scripts", "skills", "cordis.patch.yml", "README.md", "LICENSE", "NOTICE", "docs/ARCHITECTURE.md", "docs/SETTINGS.md", "docs/TOOLS.md"],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test --test-isolation=none .test-build/tests/*.test.js",
    "bench": "node bench/run.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0"
  }
}
